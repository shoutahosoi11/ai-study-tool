PORT=8080
# Local Docker:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ai_study_tool?sslmode=disable
# Production Neon example:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DB_NAME?sslmode=require
FIREBASE_CREDENTIALS_PATH=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
GEMINI_API_KEY=
USE_GEMINI_MOCK=false
GEMINI_TIMEOUT_SECONDS=90
GEMINI_MAX_RETRIES=2
GEMINI_RETRY_BASE_DELAY_MS=1500
GCS_BUCKET_NAME=
GCS_SIGNING_SERVICE_ACCOUNT=
QUESTION_SYNC_PER_TRIGGER_LIMIT=30
QUESTION_SYNC_DAILY_LIMIT=100
QUESTION_SYNC_STALE_PROCESSING_SECONDS=600
QUESTION_SYNC_WORKER_TIMEOUT_SECONDS=120
QUESTION_WORKER_POLL_INTERVAL_SECONDS=600
