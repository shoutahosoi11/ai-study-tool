PORT=8080
APP_ENV=development
GCP_PROJECT_ID=
SHUTDOWN_TIMEOUT_SECONDS=90

# ── DB ──────────────────────────────────────────────────────────────
# Local:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ai_study_tool?sslmode=disable
# Production (Secret Manager で管理 / APP_ENV=production では sslmode=require 必須):
# Cloud Run からは必ず -pooler 付き URL (PgBouncer経由) を使うこと
# DATABASE_URL=postgresql://USER:PASS@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/DB?sslmode=require
# Deploy migration 用。未設定なら deploy workflow は DATABASE_URL を使う。
MIGRATION_DATABASE_URL=
FIREBASE_CREDENTIALS_PATH=
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SESSION_COOKIE_DOMAIN=
CSRF_SECRET=
# CSRF_SECRET を未設定でローカル起動したい場合のみ true。production では無効。
CSRF_SIGNING_DISABLED=false
APP_CHECK_ENFORCEMENT=false
MIN_SUPPORTED_IOS_VERSION=
MIN_SUPPORTED_ANDROID_VERSION=
CSP_REPORT_URI=
GEMINI_API_KEY=
USE_GEMINI_MOCK=false
GEMINI_TIMEOUT_SECONDS=90
GEMINI_TOTAL_TIMEOUT_SECONDS=60
GEMINI_MAX_RETRIES=2
GEMINI_RETRY_BASE_DELAY_MS=1500
GEMINI_RETRY_MAX_DELAY_MS=15000
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME_SECONDS=1800
DB_CONN_MAX_IDLE_SECONDS=300
QUESTION_SYNC_PER_TRIGGER_LIMIT=30
QUESTION_SYNC_DAILY_LIMIT=100
QUESTION_SYNC_STALE_PROCESSING_SECONDS=600
QUESTION_SYNC_WORKER_TIMEOUT_SECONDS=120
QUESTION_WORKER_POLL_INTERVAL_SECONDS=600
QUESTION_JOB_MAX_PENDING_PER_USER=20
QUESTION_JOB_MAX_PENDING_PER_BOOK=3
QUESTION_JOB_MAX_PENDING_GLOBAL=1000
GLOBAL_LLM_DAILY_MAX_REQUESTS=500
GLOBAL_LLM_DAILY_MAX_ESTIMATED_COST_YEN=500
LLM_ESTIMATED_COST_YEN_PER_REQUEST=1
HIGHLIGHT_INGEST_DAILY_LIMIT=100
QUESTION_GENERATION_DAILY_LIMIT=50
POST_DAILY_LIMIT=50
SOCIAL_ACTION_DAILY_LIMIT=500
TOKEN_AWARD_DAILY_LIMIT=10
AD_REWARD_HMAC_SECRET=
ADMOB_SSV_PUBLIC_KEYS_URL=
QUEUE_QUESTION_GENERATION=
QUEUE_HIGHLIGHT_IMPORT=
TASK_HANDLER_BASE_URL=
INTERNAL_TASK_SECRET=
INTERNAL_TASK_INVOKER_SERVICE_ACCOUNT=

# ── Stripe ──────────────────────────────────────────────────────────
# Stripe をローカルで使う場合だけ実値に置き換える。
# 機密値は Secret Manager で管理（ローカルのみここに設定）
STRIPE_SECRET_KEY=sk_test_YOUR_TEST_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_LOCAL_WEBHOOK_SECRET
# 非機密値は GitHub Actions vars で管理
STRIPE_PRICE_ID_MONTHLY=price_XXXXXXXXXX
STRIPE_SUCCESS_URL=http://localhost:3000/billing/success
STRIPE_CANCEL_URL=http://localhost:3000/billing/cancel
